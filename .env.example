# ================================================================
# Outreach Control — konfigurasi. Salin ke .env lalu isi nilainya.
# .env berisi rahasia: jangan dibagikan, jangan di-commit.
# Setelah mengubah .env, restart backend.
# ================================================================

# ---------- LLM (OpenRouter) ----------
# Key: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# Model terverifikasi tersedia & mendukung structured outputs (17-09-2026)
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_APP_NAME=Outreach Control Kelompok 1
LLM_MAX_TOKENS=1200

# ---------- Enrichment (Apify) ----------
# Token: https://console.apify.com/settings/integrations
APIFY_TOKEN=
# Actor pencari profil, format username~nama-actor (contoh: username~people-finder)
APIFY_ENRICHMENT_ACTOR=
# Input actor (JSON). Placeholder: {name} {company} {domain} {email} {title_hint} {linkedin_url} {lead_id}
# Sesuaikan dengan skema input actor (tab Input di halaman actor). Lead yang nilai placeholder-nya kosong
# tidak memanggil Apify (tidak ada biaya). Contoh untuk anchor~linkedin-profile-enrichment:
APIFY_ENRICHMENT_INPUT={"startUrls": [{"url": "{linkedin_url}", "id": "{lead_id}"}]}
APIFY_TIMEOUT_SECONDS=120
APIFY_MAX_ITEMS=5

# ---------- Riset web (Firecrawl) ----------
# Key: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=
FIRECRAWL_RESULTS_PER_LEAD=3

# ---------- Google: tanpa refresh token manual ----------
# Di Google Cloud Console (satu project): aktifkan Google Sheets API dan Gmail API.
#
# SHEETS -> service account
#   IAM & Admin > Service Accounts > buat > Keys > Add key > JSON. Simpan file ke folder secrets/ (di-gitignore).
#   Buka spreadsheet > Share > tambahkan email service account (…@….iam.gserviceaccount.com) sebagai Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/google-service-account.json
#
# GMAIL -> tombol "Hubungkan akun Google" di tab Koneksi dashboard
#   APIs & Services > Credentials > OAuth client ID tipe "Desktop app" (atau "Web application" dengan
#   Authorized redirect URI = GOOGLE_OAUTH_REDIRECT_URI). OAuth consent screen: tambahkan akun pengirim sebagai Test user.
#   Alamat pengirim diambil otomatis dari akun yang login; token disimpan di backend/data/google-oauth.json.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/google/callback
# Alamat dashboard untuk kembali setelah login Google (dev: Vite 5173; build: http://127.0.0.1:8000)
APP_URL=http://localhost:5173

# ID spreadsheet dari URL: https://docs.google.com/spreadsheets/d/<ID>/edit
# Tab Campaigns, Leads, Evidence, Templates, Tasks, Emails, Suppression, Audit dibuat otomatis.
SHEETS_SPREADSHEET_ID=
# sheets = Google Sheets (fallback ke file lokal bila belum dikonfigurasi) | local = file lokal
DATA_BACKEND=sheets
SHEETS_FLUSH_SECONDS=2

# ---------- Pengiriman (Gmail API) ----------
# Pengaman: email hanya terkirim bila true DAN penerima ada di allowlist
GMAIL_SEND_ENABLED=false
# Pisahkan dengan koma. Alamat lengkap atau domain berawalan @ (contoh: anggota@gmail.com,@ugm.ac.id)
GMAIL_ALLOWLIST=
# Jeda antar-email (jendela kirim bertahap)
SEND_INTERVAL_SECONDS=20

# ---------- Mode simulasi (hanya uji tanpa key) ----------
# true = integrasi yang BELUM dikonfigurasi memakai data fiktif; yang sudah dikonfigurasi tetap live.
SIMULATE_INTEGRATIONS=false

# ---------- Batas agen (laporan §5.2) ----------
RUNTIME_A_WORKERS=3
RUNTIME_B_WORKERS=2
BATCH_SIZE=25
MAX_FACTS=3
MAX_REVISIONS=2
MAX_RETRY=3
LEASE_SECONDS=90
ENTITY_ACCEPT_THRESHOLD=0.85
ENTITY_MIN_GAP=0.10
DEFAULT_TIMEZONE=Asia/Jakarta
CORS_ORIGINS=http://localhost:5173
